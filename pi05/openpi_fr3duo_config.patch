+# --- C2 Hackathon: FR3 Duo handover (see pi05/ in the project repo) ---
+FR3DUO_PROMPT = "Hand the box from the left gripper to the right gripper and place it on the serving tray."
+
+
+@dataclasses.dataclass(frozen=True)
+class LeRobotFR3DuoDataConfig(DataConfigFactory):
+    """FR3 Duo, 16 dims: left q1-q7, left gripper, right q1-q7, right gripper. Absolute joint targets in the data."""
+
+    # If true, joints become deltas w.r.t. the current state; grippers stay absolute.
+    use_delta_joint_actions: bool = True
+    default_prompt: str | None = FR3DUO_PROMPT
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        # Dataset keys (written by convert_fr3duo_to_openpi.py) -> keys the sim client sends at inference.
+        repack_transform = _transforms.Group(
+            inputs=[
+                _transforms.RepackTransform(
+                    {
+                        "images": {
+                            "external_image": "external_image",
+                            "left_wrist_image": "left_wrist_image",
+                            "right_wrist_image": "right_wrist_image",
+                        },
+                        "state": "state",
+                        "actions": "actions",
+                        "prompt": "prompt",
+                    }
+                )
+            ]
+        )
+        data_transforms = _transforms.Group(
+            inputs=[fr3duo_policy.FR3DuoInputs()],
+            outputs=[fr3duo_policy.FR3DuoOutputs()],
+        )
+        if self.use_delta_joint_actions:
+            delta_action_mask = _transforms.make_bool_mask(7, -1, 7, -1)
+            data_transforms = data_transforms.push(
+                inputs=[_transforms.DeltaActions(delta_action_mask)],
+                outputs=[_transforms.AbsoluteActions(delta_action_mask)],
+            )
+        model_transforms = ModelTransformFactory(default_prompt=self.default_prompt)(model_config)
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+        )
+
